# Copy to .env for Docker Compose overrides
CLAIMLENS_API_PORT=8000
CLAIMLENS_WEB_PORT=8501
# Local API persistence defaults to <project>/data/claimlens.db.
# Docker Compose overrides persistence paths explicitly.
MAX_UPLOAD_BYTES=26214400
MAX_PDF_PAGES=100
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=llama3.2
OLLAMA_PORT=11434
